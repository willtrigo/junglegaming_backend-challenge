# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000

# Compose build/run selection (development | production)
BUILD_TARGET=development
API_COMMAND=dev
WORKER_COMMAND=dev:worker

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
POSTGRES_PORT=5432

DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering

# --- AWS SQS via MiniStack ---------------------------------------------------
AWS_EMULATOR_PORT=4566
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_MAX_RECEIVE_COUNT=5

SQS_WAIT_TIME_SECONDS=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_CONSUMER_CONCURRENCY=10

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_BACKOFF_MS=60000

PENDING_REFERENCE_POLL_INTERVAL_MS=2000
PENDING_REFERENCE_MAX_ATTEMPTS=8
PENDING_REFERENCE_BASE_BACKOFF_MS=1000
PENDING_REFERENCE_TTL_SECONDS=300

SHUTDOWN_GRACE_PERIOD_MS=30000
